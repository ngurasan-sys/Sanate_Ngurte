UPSTOX_API_KEY=
UPSTOX_API_SECRET=
UPSTOX_REDIRECT_URI=http://localhost:8000/api/v1/broker/upstox/callback

# ---------------------------------------------------------------------
# ORDER EXECUTION — READ BEFORE CHANGING
# ---------------------------------------------------------------------
# DRY_RUN  (default) Builds and logs the order payload. NO network call,
#                    no broker contact, no money at risk.
# SANDBOX            Sends to Upstox's sandbox host using a separate
#                    sandbox token. No real money.
# LIVE               REAL MONEY. Sends real orders to the real broker.
#
# LIVE additionally requires UPSTOX_LIVE_TRADING_CONFIRMED=YES below, so
# that no single stray variable can arm real-money trading on its own.
UPSTOX_EXECUTION_MODE=DRY_RUN

# Must be exactly "YES" (uppercase) for LIVE mode to actually arm.
# Leave blank unless you fully intend to trade real money.
UPSTOX_LIVE_TRADING_CONFIRMED=

# Sandbox-only token from the Upstox developer console. This token cannot
# place live orders, and your live token cannot place sandbox orders.
UPSTOX_SANDBOX_ACCESS_TOKEN=
